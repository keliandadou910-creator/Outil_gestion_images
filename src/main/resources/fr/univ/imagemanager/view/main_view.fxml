<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>


<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.univ.imagemanager.controller.MainController"
            styleClass="root-pane">

    <!-- Barre du menu -->
    <top>
        <MenuBar styleClass="menu-bar">
            <Menu text="Fichier">
                <MenuItem text="Ouvrir une image..." onAction="#ouvrirImage"
                          accelerator="Ctrl+O"/>
                <MenuItem text="Sauvegarder l'image..." onAction="#sauvegarderImage"
                          accelerator="Ctrl+S"/>
                <SeparatorMenuItem/>
                <MenuItem text="Réinitialiser l'image" onAction="#reinitialiserImage"
                          accelerator="Ctrl+Z"/> 
            </Menu>

        </MenuBar> 
    </top>

    <!-- le panneau latérale gauche -->
    <left>
        <ScrollPane fitToWidth="true" styleClass="sidebar-scroll">
            <VBox spacing="8" styleClass="sidebar">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <!-- Filtres de couleurs -->
                <Label text="🎨 Filtres" styleClass="section-title"/>
                <Button text="Échange RGB → GBR" onAction="#appliquerEchangeRGB"
                        maxWidth="Infinity" styleClass="filter-button"/>
                <Button text="Noir et Blanc" onAction="#appliquerNoirEtBlanc"
                        maxWidth="Infinity" styleClass="filter-button"/>
                <Button text="Sépia" onAction="#appliquerSepia"
                        maxWidth="Infinity" styleClass="filter-button"/>
                <Button text="Prewitt (Contours)" onAction="#appliquerPrewitt"
                        maxWidth="Infinity" styleClass="filter-button"/>

                <Separator/>

                <!-- Section transformations géométriques -->
                <Label text="🔄 Transformations" styleClass="section-title"/>
                <Button text="Rotation 90°" onAction="#appliquerRotation90"
                        maxWidth="Infinity" styleClass="transform-button"/>
                <Button text="Rotation 180°" onAction="#appliquerRotation180"
                        maxWidth="Infinity" styleClass="transform-button"/>
                <Button text="Rotation 270°" onAction="#appliquerRotation270"
                        maxWidth="Infinity" styleClass="transform-button"/>

                <Separator/>

                <Button text="Symétrie Horizontale" onAction="#appliquerSymetrieH"
                        maxWidth="Infinity" styleClass="transform-button"/>
                <Button text="Symétrie Verticale" onAction="#appliquerSymetrieV"
                        maxWidth="Infinity" styleClass="transform-button"/>


                <Separator/>

                <!-- Section Sécurité -->
                <Label text="🔒 Sécurité" styleClass="section-title"/>
                <Button text="Chiffrer l'image" onAction="#chiffrerImage"
                        maxWidth="Infinity" styleClass="security-button"/>
                <Button text="Déchiffrer l'image" onAction="#dechiffrerImage"
                        maxWidth="Infinity" styleClass="security-button"/>

                <Separator/>

                <!-- Le Bouton réinitialiser --> 
                <Button text="↩ Réinitialiser" onAction="#reinitialiserImage"
                        maxWidth="Infinity" styleClass="reset-button"/>
            
            </VBox>
        </ScrollPane>
        <!-- Fin du panneau latérale gauche -->
    </left>

    <!-- Zone pour l'image (au centre) -->
    <center>
        <VBox styleClass="center-zone">
            <ScrollPane fx:id="scrollPane" fitToWidth="true" fitToHeight="true"
                        VBox.vgrow="ALWAYS" styleClass="image-scroll">
                <ImageView fx:id="imageView" preserveRatio="true"/>
            </ScrollPane>
            <HBox spacing="10" styleClass="info-bar">
                <padding>
                    <Insets top="8" right="12" bottom="8" left="12"/>
                </padding>
                <Label fx:id="labelInfo" text="Bienvenue !" styleClass="info-label"/>
            </HBox>
        </VBox>
    </center>

    <!-- Zone pour les tags et les transformations (en bas) -->
    <bottom>
        <VBox spacing="8" styleClass="bottom-zone">
            <padding>
                <Insets top="10" right="15" bottom="10" left="15"/>
            </padding>

            <Label fx:id="labelTransformations" text="Aucune transformation appliquée."
                   styleClass="transformations-label" wrapText="true"/>

            <Separator/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="🏷️ Tags :" styleClass="section-title"/>
                <TextField fx:id="champTag" promptText="Ajouter un tag..."
                           onAction="#ajouterTag" HBox.hgrow="ALWAYS"
                           styleClass="tag-input"/>
                <Button text="Ajouter" onAction="#ajouterTag"
                        styleClass="add-tag-button"/>
            </HBox>


           <FlowPane fx:id="conteneurTags" hgap="8" vgap="6"
                      styleClass="tags-container"/>
        </VBox>
    </bottom>
</BorderPane>
